FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install ARM toolchain and development utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc-arm-none-eabi \
    binutils-arm-none-eabi \
    libnewlib-arm-none-eabi \
    cmake \
    make \
    gdb-multiarch \
    openocd \
    stm32flash \
    git \
    python3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["/bin/bash"]